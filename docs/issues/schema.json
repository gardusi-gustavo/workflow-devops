{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local task",
  "type": "object",
  "required": [
    "rank",
    "title",
    "context",
    "limits",
    "spec"
  ],
  "properties": {
    "rank": {
      "type": "string",
      "pattern": "^[123]\\.[0-9]{1,6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "required": [
        "max_commits",
        "max_file_changes"
      ],
      "properties": {
        "max_commits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_file_changes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "summary",
        "expected_outcome",
        "acceptance_criteria"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcome": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "summary"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "next_step": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
