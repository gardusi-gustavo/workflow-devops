{
  "id": "vault.classify",
  "version": "1.0.0",
  "kind": "transform",
  "timeout_seconds": 120,
  "input_object_schema": "schemas/vault/collections.schema.json#/$defs/itemInputList",
  "output_object_schema": "schemas/vault/collections.schema.json#/$defs/itemClassifiedList",
  "transition": {
    "from": [
      "input"
    ],
    "to": "processing"
  },
  "idempotency": "id + size_bytes",
  "side_effects": [
    "state.write",
    "event.append"
  ],
  "resources": {
    "io": "light",
    "cpu": "low",
    "network": false
  },
  "command": "sb run vault.classify --root . --json",
  "execution_strategy": {
    "type": "matrix",
    "iterate_over_input": "items",
    "concurrency": 2
  },
  "preconditions": [
    {
      "check": "schema_valid"
    }
  ],
  "postconditions": [
    {
      "check": "stage",
      "value": "processing"
    }
  ],
  "failure_classes": [
    "invalid_input",
    "unknown_domain"
  ],
  "retry": {
    "max_attempts": 0,
    "on": []
  }
}
